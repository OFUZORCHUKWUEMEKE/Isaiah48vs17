# =============================================================================
# Memecoin Runner Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values.
# Anything left blank will fall back to mock data (so the agent still runs).

# --- Telegram (for alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Helius (for wallet transaction tracking) ---
# Get a free key at https://helius.dev
HELIUS_API_KEY=

# --- Birdeye (for top-10 holder data) ---
# Get a free key at https://birdeye.so
BIRDEYE_API_KEY=

# --- Mode ---
# "paper" = track hypotheticals only (RECOMMENDED for first 2 weeks)
# "alert" = send real alerts (default for v1)
# "live"  = auto-execute trades (NOT IMPLEMENTED in v1)
AGENT_MODE=paper

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
