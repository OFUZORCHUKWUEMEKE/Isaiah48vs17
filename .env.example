# =============================================================================
# Memecoin Runner Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real values.
# Anything left blank will fall back to mock data (so the agent still runs).

# --- Telegram (for alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Helius (for wallet transaction tracking) ---
# Get a free key at https://helius.dev
HELIUS_API_KEY=

# --- Birdeye (for top-10 holder data) ---
# Get a free key at https://birdeye.so
BIRDEYE_API_KEY=

# --- GMGN (optional; not yet wired into the scan loop - config.json's
# "gmgn" block is enabled: false until docs/gmgn-integration-plan.md's
# later stages land) ---
# Register at https://gmgn.ai/ai
GMGN_API_KEY=
# Leave blank to use the client's default; set only if GMGN gives you a
# different base URL than https://api.gmgn.ai
GMGN_BASE_URL=

# --- Mode ---
# "paper" = track hypotheticals only (RECOMMENDED for first 2 weeks)
# "alert" = send real alerts (default for v1)
# "live"  = auto-execute trades (NOT IMPLEMENTED in v1)
AGENT_MODE=paper

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
