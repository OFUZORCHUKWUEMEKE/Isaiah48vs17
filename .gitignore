# --- Secrets (NEVER commit these) ---
.env
*.env.local
*.env.production

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/

# --- Build / distribution ---
build/
dist/
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node (gmgn-cli, installed locally by nixpacks.toml - see src/data/gmgn.py) ---
# package.json/package-lock.json ARE committed for reproducible builds -
# only the installed tree itself is ignored.
node_modules/

# --- Agent runtime state ---
# Comment these out if you WANT to commit pre-computed wallet scores
# and the paper ledger to your repo. Default: keep them out so Railway
# rebuilds scoring from scratch on each deploy.
data/wallet_scores.json
data/paper_ledger.json
data/alerts.log

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Logs ---
logs/
*.log
